# Contracts Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# For deploying to testnets/mainnet, you'll need:

# Ethereum Network RPC URLs
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Alternative: Infura RPC URLs
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Private Key (NEVER commit the actual .env file with real key!)
PRIVATE_KEY=your_private_key_here

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Note: For local Hardhat development, no .env file is needed
# The default configuration in hardhat.config.js works out of the box
